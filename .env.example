# Copy to .env and fill in what you need (this file is loaded by app/main.py
# and app/ai_evaluate.py via python-dotenv). .env itself is gitignored.

# Required only for the AI evaluation step (app/ai_evaluate.py).
# Get one at https://aistudio.google.com/ or https://console.anthropic.com/
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...

# Select the AI provider: 'gemini' or 'anthropic' (default is 'anthropic')
AI_PROVIDER=anthropic

# Optional: override the default models used for scoring.
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_MODEL=claude-haiku-4-5

# Required only if you enable an Adzuna entry in aggregators.yaml.
# Free signup at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
